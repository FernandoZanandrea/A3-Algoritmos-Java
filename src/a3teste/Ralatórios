package a3teste;

import javax.swing.JOptionPane;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.text.NumberFormat;
import java.util.Locale;

public class A3TESTE {

    public static void main(String[] args) {
        
    int Relatorios;
    // Dados fictícios utilizados para testar os relatórios.
    
    // Número de identificação de cada conta
    int[] documentos = new int[3];
        documentos[0] = 101;
        documentos[1] = 102;    
        documentos[2] = 103;
    
    // Descrição da despesa    
    String[] descricoes = new String[3];
        descricoes[0] = "Energia elétrica";
        descricoes[1] = "Água";
        descricoes[2] = "Internet";
        
    // Nome do beneficiário do pagamento    
     String[] beneficiarios = new String[3];
        beneficiarios[0] = "Celesc";
        beneficiarios[1] = "Casan";
        beneficiarios[2] = "Operadora de internet"; 
        
    // Valor original da conta    
    double[] valores = new double[3];
        valores[0] = 250.00;
        valores[1] = 120.50;
        valores[2] = 99.90;  
    
    // Data de vencimento    
    LocalDate[] vencimentos = new LocalDate[3];
        vencimentos[0] = LocalDate.of(2026, 11, 15 );
        vencimentos[1] = LocalDate.of(2026, 11, 20 );       
        vencimentos[2] = LocalDate.of(2026, 12, 05 );  
        
    // Valor que ainda falta pagar    
    double[] saldodevedor = new double[3];
        saldodevedor[0] = 250.00;       
        saldodevedor[1] = 70.50;       
        saldodevedor[2] = 0.00;      
                
     do{
    
    Relatorios = Integer.parseInt(JOptionPane.showInputDialog(null," Relatórios " + "\n 1 • Contas a pagar" + " \n 2 • Contas atrasadas" + " \n 3 • Balanço de despesas" + " \n 0 • Retornar"));
      
    switch (Relatorios){
    case 1:
        JOptionPane.showMessageDialog(null,"1 • Contas a pagar");
        String datainicial;
        String datafinal;
        datainicial = JOptionPane.showInputDialog(null,"Data inicial (dd/MM/aaaa)");
        datafinal = JOptionPane.showInputDialog(null,"Data final (dd/MM/aaaa)");
        DateTimeFormatter formato = DateTimeFormatter.ofPattern("dd/MM/yyyy");
        LocalDate inicio;
        LocalDate fim;
        inicio = LocalDate.parse(datainicial, formato);
        fim = LocalDate.parse(datafinal, formato);
        
        for(int n=0; n<=2; n=n +1){
            
        if ((vencimentos[n].isAfter(inicio) || vencimentos[n].isEqual(inicio)) && (vencimentos[n].isBefore(fim) || vencimentos[n].isEqual(fim)) && (saldodevedor[n] > 0)){
            JOptionPane.showMessageDialog(null,"Vencimento: " + vencimentos[n].format(formato) +  
                                               "\nDocumento: " + documentos[n] + 
                                               "\nDescrição: " + descricoes[n] + 
                                               "\nBeneficiário: " + beneficiarios[n] + 
                                               "\nValor: " + valores[n] + 
                                               "\nSaldo devedor: " + saldodevedor[n]);
        
        
        
        }
        }
            
            
     //isBefore() — verifica se uma data é anterior a outra.



    //isAfter() — verifica se uma data é posterior a outra.



    //isEqual() — verifica se as datas são iguais.     
            
            
            
            
        
    break;
    
    case 2:
    JOptionPane.showMessageDialog(null,"2 • Contas atrasadas");
    break;
    
   case 3:
    JOptionPane.showMessageDialog(null,"3 • Balanço de despesas");
    break;
    
    case 0:
    JOptionPane.showMessageDialog(null,"0 • Retornar");
    break;
   
    default:
    JOptionPane.showMessageDialog(null,"Opção inválida! ");
    break;
    }
  
    } while (Relatorios != 0);
    }
    }
